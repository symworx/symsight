# SpaceXAI / xAI API key (required for generation)
# Create a key at https://console.x.ai
XAI_API_KEY=

# Optional overrides
# SYMSIGHT_MODEL=grok-4.5
# SYMSIGHT_BASE_URL=https://api.x.ai/v1
# A localhost base URL uses a local model and skips web search:
# SYMSIGHT_BASE_URL=http://127.0.0.1:11434/v1
# SYMSIGHT_ACTIVE_BRAND=example-writer
# SYMSIGHT_BRANDS_DIR=./config/brands
# SYMSIGHT_DRAFTS_DIR=./content/drafts
# SYMSIGHT_FINAL_DIR=./content/final
